// --- Wave58: Reliable internal service dispatch (Service Outbox) + persistent Export Jobs ---

enum ExportJobStatus {
  queued
  running
  completed
  failed
}

enum ServiceOutboxKind {
  exports_render
}

enum ServiceOutboxStatus {
  pending
  processing
  dispatched
  failed
  dead
}

model ExportJob {
  id               String          @id @default(cuid())
  organizationId   String
  approvalPacketId String
  requestedByUserId String?
  status           ExportJobStatus @default(queued)

  // Full request snapshot (so exports are reproducible even if upstream content changes later)
  request          Json
  payloadHash      String?
  idempotencyKey   String?         @unique

  // Result snapshot (attachment ids + warnings)
  result           Json?
  warnings         String[]        @default([])
  error            String?

  correlationId    String?
  traceparent      String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy      User?           @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  artifacts        ExportArtifact[]

  @@index([organizationId, approvalPacketId])
  @@index([organizationId, status])
  @@index([createdAt])
}

model ExportArtifact {
  id          String     @id @default(cuid())
  exportJobId String
  attachmentId String
  name        String
  mimeType    String
  sha256      String
  sizeBytes   Int
  createdAt   DateTime   @default(now())

  job         ExportJob   @relation(fields: [exportJobId], references: [id], onDelete: Cascade)
  attachment  Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([exportJobId, name])
  @@index([exportJobId])
}

model ServiceOutboxEvent {
  id             String            @id @default(cuid())
  kind           ServiceOutboxKind
  status         ServiceOutboxStatus @default(pending)

  organizationId String?
  aggregateType  String
  aggregateId    String

  // Outgoing payload (for internal service call)
  payload        Json
  dedupKey       String?

  attempts       Int               @default(0)
  nextAttemptAt  DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?

  correlationId  String?
  traceparent    String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  dispatchedAt   DateTime?

  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([kind])
  @@index([aggregateType, aggregateId])
  @@index([organizationId])
}

