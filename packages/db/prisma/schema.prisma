  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceSignal    CulturalSignal?   @relation(fields: [sourceSignalId], references: [id], onDelete: SetNull)
  categoryAssignments    CompetitionCategoryAssignment[]
  requirements    CompetitionRequirement[]

  @@index([organizationId, projectId, status])
  @@index([dueAt])
}

model CompetitionRequirement {
  id             String                       @id @default(cuid())
  competitionId  String
  category       CompetitionRequirementCategory
  discipline     CompetitionDiscipline
  textAr         String                       @db.Text
  cityOrLocation String?
  quantitiesJson Json?
