enum OutboxStatus {
  pending
  sending
  sent
  failed
}

model OutboxMessage {
  id             String       @id @default(cuid())
  organizationId String?
  channel        String
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  sentAt         DateTime?

  // Wave45: incident grouping + dedup + quiet-hours suppression
  dedupKey        String?
  incidentKey     String?
  groupCount      Int         @default(1)
  suppressedUntil DateTime?
  lastEmittedAt   DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([dedupKey, createdAt])
  @@index([incidentKey, createdAt])
}

enum HeritageAssetType { material immaterial architectural }
enum HeritageAccessLevel { public researchers internal restricted }

model HeritageAsset {
  id              String              @id @default(cuid())
  organizationId  String
  createdById     String
