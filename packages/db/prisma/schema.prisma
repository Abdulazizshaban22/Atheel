generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum OrgSector { government semi_government museum private developer ngo }
enum ProjectStatus { draft planning in_progress paused completed archived }
enum ContentStatus { draft in_review approved published archived }
enum ContentType { article stop_text audio_script label educational campaign presentation strategy feasibility approval_packet }
enum ExperienceType { museum route event exhibition food_culture }
enum PlatformRole {
  super_admin
  org_admin
  project_manager
  curator
  content_editor
  experience_designer
  analyst
  viewer
}

// Wave55: multi-device refresh sessions with rotation + reuse detection
enum RefreshSessionState { active revoked compromised expired }

// Wave55: fine-grained authorization rules (resource/action)
enum PolicyEffect { allow deny }

// Wave56: Capability Packs (تشغيل المنصة كـ مشغل متعدد المجالات)
enum CapabilityDomain { core culture heritage ops ai twin compliance radar integration other }

enum ApprovalStatus {
  draft
  submitted
  in_review
  approved
  rejected
  changes_requested
  cancelled
}
enum ApprovalEntityType {
  project
  content
  experience
  // Wave48: برامج تشغيل + مواسم + سجل تراث + حزم امتثال/تراخيص
  program
  season
  heritage_asset
  licensing_checklist
}
enum AuditSeverity { info warning critical }

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  displayName      String
  isActive         Boolean              @default(true)
  passwordHash     String?
  // Deprecated (Wave55): used by early auth scaffolding. Keep for backward compatibility.
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  memberships      OrganizationMember[]
  attachments      Attachment[]         @relation("AttachmentUploader")
  auditLogs        AuditLog[]           @relation("AuditActor")
  createdHeritageAssets HeritageAsset[] @relation("UserCreatedHeritageAssets")

  refreshSessions   RefreshSession[]
  policyRules       PolicyRule[]

  @@index([email])
  @@index([isActive])
}

// Wave55: multi-device refresh sessions
model RefreshSession {
  id            String               @id @default(cuid())
  userId        String
  familyId      String
  state         RefreshSessionState @default(active)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastSeenAt    DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  compromisedAt DateTime?
  ip            String?
  userAgent     String?
  deviceName    String?

  currentTokenId String
  currentToken   RefreshSessionToken   @relation("CurrentSessionToken", fields: [currentTokenId], references: [id])
  tokens         RefreshSessionToken[] @relation("SessionTokens")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([familyId])
}

model RefreshSessionToken {
  id               String   @id @default(cuid())
  sessionId        String
  tokenHash        String   @unique
  issuedAt         DateTime @default(now())
  usedAt           DateTime?
  revokedAt        DateTime?
  replacedByTokenId String?

  session          RefreshSession  @relation("SessionTokens", fields: [sessionId], references: [id], onDelete: Cascade)
  currentOf        RefreshSession? @relation("CurrentSessionToken")

  @@index([sessionId, issuedAt])
  @@index([sessionId, usedAt])
}

// Wave55: fine-grained policy rules
model PolicyRule {
  id             String       @id @default(cuid())
  organizationId String
  role           PlatformRole?
  userId         String?
  resource       String
  action         String
  effect         PolicyEffect @default(allow)
  conditions     Json?
  priority       Int          @default(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, role, resource, action])
  @@index([organizationId, userId])
}

model Organization {
  id          String               @id @default(cuid())
  nameAr      String
  nameEn      String?
  sector      OrgSector
  city        String?
  country     String               @default("SA")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  projects    Project[]
  content     ContentItem[]
  members     OrganizationMember[]
  attachments Attachment[]
  approvals   ApprovalRequest[]
  auditLogs   AuditLog[]
  heritageAssets HeritageAsset[]

  policyRules    PolicyRule[]
  capabilities   OrganizationCapability[]

  @@index([sector])
  @@index([country, city])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           PlatformRole
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId, role])
}

// Wave56: Capability Packs (Catalog + per-organization enablement)
model CapabilityPack {
  id             String           @id @default(cuid())
  code           String           @unique
  nameAr         String
  nameEn         String?
  domain         CapabilityDomain @default(other)
  descriptionAr  String?
  modules        String[]
  requires       String[]
  defaultEnabled Boolean          @default(false)
  manifest       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  orgs           OrganizationCapability[]

  @@index([domain])
}

model OrganizationCapability {
  id              String         @id @default(cuid())
  organizationId  String
  packId          String
  isEnabled       Boolean        @default(true)
  enabledAt       DateTime?
  disabledAt      DateTime?
  config          Json?
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pack            CapabilityPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  updatedBy       User?          @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, packId], name: "organizationId_packId")
  @@index([organizationId, isEnabled])
}


model Project {
  id               String           @id @default(cuid())
  organizationId   String
  code             String
  nameAr           String
  status           ProjectStatus    @default(draft)
  progressPercent  Int              @default(0)
  startDate        DateTime?
  endDate          DateTime?
  ownerDisplayName String?
  budgetEstimate   Decimal?         @db.Decimal(14, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content          ContentItem[]
  experiences      VisitorExperience[]

  @@unique([organizationId, code])
  @@index([status])
}

model ContentItem {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  languageCode   String
  contentType    ContentType
  status         ContentStatus @default(draft)
  summary        String?
  versionNo      Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([contentType, languageCode])
}

model VisitorExperience {
  id                     String         @id @default(cuid())
  projectId              String
  titleAr                String
  twinId                 String?        @unique
  experienceType         ExperienceType
  durationMinutesDefault Int
  publishStatus          String         @default("draft")
  targetAudience         String?
  accessibilityFlags     Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  twin                   Twin?          @relation("ExperienceTwin", fields: [twinId], references: [id], onDelete: SetNull)

  @@index([projectId, publishStatus])
  @@index([experienceType])
}

model Attachment {
  id              String       @id @default(cuid())
  organizationId  String
  // NOTE: generalized polymorphic link (e.g., project/content/experience/competition/cultural_signal/...)
  // Keep approvals.entityType as enum, but attachments.entityType is flexible to support new modules without enum migrations.
  entityType      String?
  entityId        String?
  originalName    String
  mimeType        String?
  extension       String?
  sizeBytes       Int
  storageProvider String       @default("local")
  storagePath     String
  checksumSha256  String?
  uploadedByUserId String?
  uploadedAt      DateTime     @default(now())
  metadata        Json?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy      User?        @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, uploadedAt])
  @@index([entityType, entityId])
}

model ApprovalRequest {
  id                String             @id @default(cuid())
  organizationId    String
  entityType        ApprovalEntityType
  entityId          String
  title             String
  status            ApprovalStatus     @default(draft)
  submittedByUserId String?
  currentApproverId String?
  decisionNote      String?
  requestedChanges  String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  dueAt             DateTime?
  // Wave46: routing context for smarter Skill Matrix (violationType/domain/region)
  contextViolationType String?
  contextDomain        String?
  contextRegion        String?
  payloadSnapshot   Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([organizationId, contextViolationType])
  @@index([organizationId, contextDomain])
  @@index([organizationId, contextRegion])
}


// Wave45: Auto-routing Skill Matrix + Ops Settings + SLO burn-rate alerts
model OpsSettings {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  quietHoursStart          String?      // "23:00"
  quietHoursEnd            String?      // "07:00"
  quietHoursTz             String       @default("Asia/Riyadh")
  outboxDedupWindowMinutes Int          @default(30)
  // Wave46: approvals routing fairness/cooldown settings
  approvalsReviewerCooldownMinutes Int   @default(5)
  approvalsMaxActivePerReviewer    Int   @default(10)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Wave46: routing fairness state (round-robin + cooldown)
model ApprovalRoutingState {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  lastAssignedAt DateTime?
  assignedCount  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, lastAssignedAt])
}

// Wave46: incidents as first-class objects (timeline + ack/close/mute)
model Incident {
  id             String       @id @default(cuid())
  organizationId String
  incidentKey    String
  title          String?
  severity       String       @default("warning")
  status         String       @default("open") // open | ack | muted | closed
  mutedUntil     DateTime?
  ackedAt        DateTime?
  ackedByUserId  String?
  closedAt       DateTime?
  closedByUserId String?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  eventCount     Int          @default(0)
  metaJson       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         IncidentEvent[]

  @@unique([organizationId, incidentKey])
  @@index([organizationId, status, lastSeenAt])
}

model IncidentEvent {
  id             String       @id @default(cuid())
  incidentId     String
  organizationId String
  eventType      String
  actorType      String       @default("system") // user | worker | system
  actorUserId    String?
  message        String?
  payload        Json?
  createdAt      DateTime     @default(now())

  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
}

model ApprovalReviewerSkill {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  dimension      String       // e.g. "entityType:content"
  score          Float        @default(0)
  evidenceCount  Int          @default(0)
  lastUpdatedAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, dimension])
  @@index([organizationId, userId])
  @@index([organizationId, dimension])
}

model SloPolicy {
  id                    String       @id @default(cuid())
  organizationId        String?
  name                  String
  indicator             String       // outbox_delivery | workflow_sla | approvals_sla
  objectivePercent      Float        @default(99.9)
  errorBudgetWindowDays Int          @default(30)
  shortWindowMinutes    Int          @default(5)
  longWindowMinutes     Int          @default(60)
  isEnabled             Boolean      @default(true)
  metaJson              Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alerts                SloAlert[]

  @@index([organizationId, isEnabled, updatedAt])
  @@index([indicator, isEnabled])
}

model SloAlert {
  id                 String       @id @default(cuid())
  organizationId     String?
  policyId           String
  burnRateShort      Float
  burnRateLong       Float
  errorRateShort     Float
  errorRateLong      Float
  windowShortMinutes Int
  windowLongMinutes  Int
  status             String       @default("open") // open | ack | resolved
  metaJson           Json?
  createdAt          DateTime     @default(now())

  policy             SloPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([policyId, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  severity       AuditSeverity @default(info)
  message        String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([severity])
}


enum AiProviderKind {
  mock
  vllm_openai_compatible
}

enum KnowledgeSourceType {
  manual
  file
  url
  template
}

enum AgentRunStatus {
  queued
  running
  completed
  needs_input
  failed
}

model AiProvider {
  id                 String          @id
  organizationId     String?
  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name               String
  kind               AiProviderKind
  baseUrl            String?
  apiKeyEnvName      String?
  modelName          String?
  isActive           Boolean         @default(true)
  temperatureDefault Float?
  maxTokensDefault   Int?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([organizationId, isActive])
}

model KnowledgeDocument {
  id              String              @id
  organizationId  String?
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  sourceType      KnowledgeSourceType
  sourceRef       String?
  languageCode    String              @default("ar")
  tags            String[]            @default([])
  text            String
  chunkCount      Int                 @default(0)
  metadata        Json?
  createdByUserId String?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  chunks          KnowledgeChunk[]

  @@index([organizationId, projectId])
  @@index([sourceType])
  @@index([tags])
}

model KnowledgeChunk {
  id             String            @id
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String?
  sourceType     KnowledgeSourceType?
  languageCode   String?
  text           String
  tags           String[]          @default([])
  chunkIndex     Int
  tokenEstimate  Int?
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([documentId, chunkIndex])
  @@index([organizationId, projectId])
  @@index([tags])
}

model KnowledgeChunkEmbedding {
  id         String @id
  documentId String
  chunkId    String @unique
  embeddingJson Json
  // Wave39: pgvector column (optional, enabled when extension is installed)
  embeddingVec Unsupported("vector")?
  dims       Int
  modelName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk      KnowledgeChunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([modelName])
}



model AgentRun {
  id              String         @id
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  objective       String
  status          AgentRunStatus
  steps           Json
  resultSummary   String?
  createdByUserId String?
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, projectId, status])
}

model PromptTemplate {
  id             String        @id
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  code           String
  name           String
  description    String?
  templateBody   String
  inputSchema    Json?
  workspaceId    String?
  tags           String[]      @default([])
  modelClass     String?
  createdByUserId String?
  isActive       Boolean       @default(true)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, code, version])
  @@index([organizationId, isActive])
}


model WorkflowInstance {
  id             String   @id
  templateId     String
  code           String
  nameAr         String
  organizationId String?
  projectId      String?
  status         String
  parametersJson String   @db.Text
  designerGraphJson String?  @db.Text
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([templateId])
  @@index([status])
}

model WorkflowRun {
  id                      String   @id
  instanceId              String?
  templateId              String
  organizationId          String?
  projectId               String?
  status                  String
  totalSteps              Int
  estimatedDurationMinutes Int
  aiCallsEstimate         Int
  humanCheckpoints        Int
  metricsJson             String   @db.Text
  traceJson               String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([templateId])
  @@index([status])
}

model WorkflowPack {
  id                    String   @id
  name                  String
  organizationId        String?
  projectId             String?
  selectedTemplateIdsJson String @db.Text
  manifestJson          String   @db.Text
  payloadJson           String   @db.Text
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId, projectId])
}


enum WorkspaceStatus {
  draft
  active
  paused
  archived
}

enum ProgramStatus {
  draft
  active
  on_hold
  completed
  archived
}

enum WorkflowExecutionPriority {
  low
  normal
  high
  urgent
}

enum WorkflowExecutionStatus {
  queued
  running
  waiting_input
  completed
  failed
  paused
}

model Workspace {
  id              String   @id
  organizationId  String?
  code            String
  name            String
  description     String?
  status          WorkspaceStatus @default(draft)
  defaultLanguage String   @default("ar")
  settingsJson    String   @db.Text
  aiRoutingPolicy Json?
  ragPolicy       Json?
  guardrails      Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Program {
  id                 String   @id
  organizationId     String?
  code               String
  nameAr             String
  description        String?
  status             ProgramStatus @default(draft)
  strategicValueScore Int     @default(0)
  readinessScore     Int      @default(0)
  portfolioValueSar  Float?
  metadataJson       String   @db.Text
  projectIdsJson     String   @db.Text
  workflowInstanceIdsJson String @db.Text
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model WorkflowExecution {
  id               String   @id
  workflowRunId     String?
  instanceId        String?
  templateId        String
  organizationId    String?
  projectId         String?
  priority          WorkflowExecutionPriority @default(normal)
  status            WorkflowExecutionStatus @default(queued)
  queueScore        Float   @default(0)
  currentStepIndex  Int     @default(0)
  stepsJson         String  @db.Text
  inputsJson        String  @db.Text
  outputsJson       String  @db.Text
  metricsJson       String  @db.Text
  slaJson           String  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  @@index([organizationId, projectId])
  @@index([status, priority])
  @@index([instanceId])
}

model WorkflowExecutionEvent {
  id               String   @id
  executionId      String
  organizationId   String?
  projectId        String?
  type             String
  stepId           String?
  messageAr        String
  payloadJson      String?  @db.Text
  idempotencyKey   String?  @unique
  attempt          Int      @default(0)
  actor            String?
  createdAt        DateTime @default(now())

  @@index([executionId, createdAt])
  @@index([organizationId, projectId])
}

model WorkflowTemplateGraph {
  id          String   @id @default(cuid())
  templateId  String   @unique
  nodesJson   String   @db.Text
  edgesJson   String   @db.Text
  metaJson    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


enum EvidenceKind {
  official_sa
  unesco
  saudipedia
  misk
  alula
  other
}

enum InspirationMediaType {
  image
  video
  pdf
  link
}

enum BrainstormBoardStatus {
  active
  archived
}

enum IdeaVaultState {
  raw
  shortlisted
  developed
  pitch_ready
  delivered
  archived
}

model InspirationSource {
  id              String   @id
  organizationId  String?
  nameAr          String
  url             String
  kind            EvidenceKind @default(other)
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([kind])
}

model InspirationAsset {
  id             String   @id
  organizationId String?
  projectId      String?
  sourceId       String?
  titleAr        String
  url            String
  mediaType      InspirationMediaType @default(link)
  regionCode     String?
  themeCode      String?
  tags           String[] @default([])
  notesAr        String?
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([sourceId])
  @@index([mediaType])
}

model BrainstormBoard {
  id             String @id
  organizationId String?
  projectId      String?
  titleAr        String
  status         BrainstormBoardStatus @default(active)
  miroBoardUrl   String?
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

