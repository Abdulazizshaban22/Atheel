// --- Digital Twin (Twin) ---

enum TwinKind { venue route exhibition district }
enum TwinStatus { draft active paused archived }
enum TwinCoordinateSystem { wgs84 local_xy }
enum TwinNodeKind { entry exit exhibit activity service rest corridor staff_only hazard }
enum TwinEdgeKind { path stairs elevator queue_lane restricted }
enum TwinLayerKind { geojson gltf three_d_tiles image pdf link }
enum TwinTelemetryKind { footfall occupancy temperature noise incident manual_note }

// --- Approval Packet (formal package for decision + autogenerated artifacts) ---

enum ApprovalPacketStatus { draft submitted approved rejected archived }

model ApprovalPacket {
  id              String   @id
  organizationId  String?
  projectId       String?
  experienceId    String?
  twinId          String?
  simulationRunId String
  scenarioKey     String   @default("baseline")
  title           String
  status          ApprovalPacketStatus @default(draft)
  version         Int      @default(1)
  sectionsJson    String   @db.Text
  artifactsJson   String   @db.Text
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([experienceId])
  @@index([twinId])
  @@index([simulationRunId])
}

model Twin {
  id               String   @id
  organizationId   String?
  projectId        String?
  kind             TwinKind
  nameAr           String
  status           TwinStatus @default(draft)
  coordinateSystem TwinCoordinateSystem @default(local_xy)
  bboxJson         String
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  nodes            TwinNode[]
  edges            TwinEdge[]
  layers           TwinLayer[]
  simulations      TwinSimulationRun[]
  telemetry        TwinTelemetryEvent[]

  // Optional: one-to-one link to a VisitorExperience (auto-created Twin per experience)
  experience       VisitorExperience? @relation("ExperienceTwin")

  @@index([organizationId, projectId])
  @@index([status])
}

model TwinNode {
  id                 String @id
  twinId             String
  nameAr             String
  kind               TwinNodeKind
  capacity           Int
  dwellTimeSecondsAvg Int
  posJson            String
  tags               String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  twin               Twin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId, kind])
}

model TwinEdge {
  id              String @id
  twinId          String
  fromNodeId      String
  toNodeId        String
  kind            TwinEdgeKind
  distanceMeters  Int
  travelTimeSeconds Int
  oneWay          Boolean @default(false)
  widthMeters     Float?
  capacityPerMinute Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  twin            Twin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId])
  @@index([fromNodeId, toNodeId])
}

model TwinLayer {
  id          String @id
  twinId      String
  nameAr      String
  kind        TwinLayerKind
  uri         String
  contentType String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  twin        Twin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId, kind])
}

model TwinSimulationRun {
  id         String @id
  twinId     String
  status     String @default("queued")
  profileJson String
  resultJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  twin       Twin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId, status])
}

model TwinTelemetryEvent {
  id        String @id
  twinId    String
  ts        DateTime
  kind      TwinTelemetryKind
  nodeId    String?
  value     Float?
  payload   Json?
  createdAt DateTime @default(now())

  twin      Twin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId, ts])
  @@index([kind])
}


enum IoTDeviceKind { sensor gateway camera counter beacon manual }

model IoTDevice {
  id            String @id
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
