// --- Wave26: Competitions / Briefs Intelligence (RFP + Scope Matrix + Staffing + Exports) ---

enum CompetitionStatus {
  draft
  analyzing
  ready
  submitted
  archived
}

enum CompetitionRequirementCategory {
  general_scope
  event_architecture
  graphic_design
  overall_direction
  out_of_scope
}

enum CompetitionDiscipline {
  architecture
  graphic
  content_experience
  visitor_experience
  operations
  finance
  project_management
}

enum CompetitionRequirementStatus {
  new
  triaged
  assigned
  clarified
  done
}

enum CompetitionAssignmentRole {
  owner
  contributor
  reviewer
}

model Competition {
  id              String            @id @default(cuid())
  organizationId  String
  projectId       String?
  titleAr         String
  code            String?
  dueAt           DateTime?
  status          CompetitionStatus @default(draft)
