  actor          User?                  @relation("OperationalEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventType, createdAt])
  @@index([subject])
  @@index([correlationId])
  @@index([requestId])
  @@index([severity])
}

model EscalationState {
  id             String    @id @default(cuid())
