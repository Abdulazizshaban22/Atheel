// Wave29: Compliance obligations (inspired by obligation management systems) - persisted and schedulable reminders
enum ObligationType {
  compliance
  crowd_safety
  sustainability
  licensing
  security
  accessibility
  insurance
  documentation
}

enum ObligationStatus {
  open
  in_progress
  done
  waived
  overdue
}

enum ObligationReminderChannel {
  in_app
  email
}

enum ObligationReminderStatus {
  pending
  sent
  cancelled
  failed
}

model Obligation {
  id                 String            @id @default(cuid())
  organizationId     String
  competitionId      String?
  requirementId      String?
  obligationKey      String            @unique
  type               ObligationType    @default(compliance)
  status             ObligationStatus  @default(open)
  titleAr            String
  descriptionAr      String?           @db.Text
  ownerUserId        String?
  dueAt              DateTime?
  workflowExecutionId String?
  metaJson           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competition        Competition?      @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  requirement        CompetitionRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  owner              User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  reminders          ObligationReminder[]

  @@index([organizationId, status])
  @@index([competitionId, status])
  @@index([requirementId])
  @@index([type])
}

model ObligationReminder {
  id            String                   @id @default(cuid())
  obligationId  String
  remindAt      DateTime
  channel       ObligationReminderChannel @default(in_app)
  status        ObligationReminderStatus  @default(pending)
  sentAt        DateTime?
  errorMessage  String?
  metaJson      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  obligation    Obligation              @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId, remindAt])
  @@index([status, remindAt])
}

// Wave43: Governance Policy Registry + Operational Events + Escalation Outbox

enum GovernancePolicyScope {
  global
  organization
}

model GovernancePolicyPack {
  id              String              @id @default(cuid())
  scope           GovernancePolicyScope @default(organization)
  organizationId  String?
  name            String
  description     String?
  isArchived      Boolean             @default(false)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation("GovernancePolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions        GovernancePolicyVersion[]
  assignments     GovernancePolicyAssignment[]

  @@index([organizationId, isArchived, createdAt])
  @@index([scope, createdAt])
}

model GovernancePolicyVersion {
  id              String              @id @default(cuid())
  packId          String
  version         String
  policyJson      Json
  sha256          String
  changelog       String?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  pack            GovernancePolicyPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation("GovernancePolicyVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments     GovernancePolicyAssignment[]

  @@unique([packId, version])
  @@index([packId, createdAt])
  @@index([sha256])
}

model GovernancePolicyAssignment {
  id               String              @id @default(cuid())
  organizationId   String
  packId           String
  versionId        String
  isActive         Boolean             @default(false)
  effectiveAt      DateTime            @default(now())
  deactivatedAt    DateTime?
  activatedByUserId String?
  createdAt        DateTime            @default(now())

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pack             GovernancePolicyPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  version          GovernancePolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  activatedBy      User?               @relation("GovernancePolicyActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive, effectiveAt])
  @@index([packId, versionId])
}

enum OperationalActorType {
  user
  service
  worker
  system
}

enum OperationalEventSeverity {
  info
  warning
  critical
}

model OperationalEvent {
  id             String                 @id @default(cuid())
  organizationId String?
  actorType      OperationalActorType   @default(user)
  actorUserId    String?
  eventType      String
  source         String?
  subject        String?
  correlationId  String?
  requestId      String?
  severity       OperationalEventSeverity @default(info)
  data           Json?
  cloudEvent     Json?
  createdAt      DateTime               @default(now())

