{
  "name": "madar-culture-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings 0",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "db:generate": "pnpm --filter @madar/db prisma:generate",
    "db:push": "pnpm --filter @madar/db prisma:db:push",
    "db:migrate:dev": "pnpm --filter @madar/db prisma:migrate:dev",
    "db:seed": "pnpm --filter @madar/db prisma:seed",
    "api:dev": "pnpm --filter @madar/api dev",
    "nx": "nx",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "run-many:build": "nx run-many -t build --all",
    "ci:verify": "pnpm db:generate && pnpm typecheck && pnpm build",
    "api:smoke": "node scripts/api-smoke.mjs",
    "final:closure:verify": "node scripts/final-closure-verify.mjs",
    "runtime:closure:run": "node scripts/runtime-closure-run.mjs",
    "runtime:wiring:audit": "node scripts/domain-wiring-audit.mjs",
    "runtime:verification:plan": "node scripts/runtime-closure-run.mjs",
    "runtime:preflight": "node scripts/runtime-preflight.mjs",
    "batch:ai-runtime:verify": "node scripts/batch-ai-runtime-verify.mjs",
    "ai:runtime:e2e:closure:verify": "node scripts/ai-runtime-e2e-closure-verify.mjs",
    "ai:runtime:execution:closure:next:verify": "node scripts/ai-runtime-execution-closure-next-verify.mjs",
    "ai:runtime:execution:closure:finalizer:verify": "node scripts/ai-runtime-execution-closure-finalizer-verify.mjs",
    "toolchain:bootstrap": "node scripts/toolchain-bootstrap.mjs",
    "execution:truth:run": "node scripts/execution-truth-run.mjs",
    "audit:ts:parse": "node scripts/audit/ts-parse-audit.mjs",
    "baseline:stabilization:verify": "node scripts/baseline-stabilization-verify.mjs",
    "audit:ts:type-risk": "node scripts/audit/ts-type-risk-audit.mjs",
    "type-risk:closure:verify": "node scripts/type-risk-closure-verify.mjs",
    "audit:ts:typecheck": "node scripts/audit/ts-typecheck-audit.mjs",
    "typecheck:closure:verify": "node scripts/typecheck-closure-verify.mjs",
    "audit:ts:packages": "node scripts/audit/ts-packages-full-audit.mjs",
    "packages:closure:verify": "node scripts/workspace-core-closure-verify.mjs",
    "artifacts:clean": "node -e \"require('node:fs').rmSync('.artifacts', { recursive: true, force: true })\"",
    "audit:ts:apps-shell": "node scripts/audit/ts-app-shell-audit.mjs",
    "apps:shell:closure:verify": "node scripts/apps-shell-closure-verify.mjs",
    "audit:truth-matrix": "node scripts/audit/truth-matrix.mjs",
    "audit:datastore": "node scripts/audit/datastore-usage-inventory.mjs",
    "audit:placeholder-migrations": "node scripts/audit/placeholder-migrations.mjs",
    "audit:endpoints": "node scripts/audit/endpoint-inventory.mjs",
    "audit:worker-contracts": "node scripts/audit/worker-contracts.mjs",
    "audit:implementation-status": "node scripts/closure-status.mjs",
    "closure:generate": "pnpm audit:truth-matrix && pnpm audit:datastore && pnpm audit:placeholder-migrations && pnpm audit:migration-closure && pnpm audit:endpoints && pnpm audit:worker-contracts && pnpm audit:implementation-status && node scripts/final-readiness-review.mjs",
    "audit:migration-closure": "node scripts/audit/migration-closure-readiness.mjs",
    "release:gate": "pnpm audit:placeholder-migrations && pnpm audit:migration-closure",
    "audit:module-boundaries": "node scripts/audit/module-boundaries.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "nx": "^20.0.0",
    "@nx/workspace": "^20.0.0"
  }
}
