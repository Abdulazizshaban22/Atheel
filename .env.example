# Core
NODE_ENV=development
# Optional: force Prisma-only persistence in any environment
STRICT_PERSISTENCE=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atheel?schema=public

# Redis (Queues + Refresh Sessions)
REDIS_URL=redis://localhost:6379

# API
PORT=3001
# can be /api or api
API_PREFIX=/api
# Comma-separated allowlist, example:
# CORS_ORIGINS=http://localhost:3000,https://app.atheel.sa
CORS_ORIGINS=http://localhost:3000
# If behind an ingress/load-balancer set TRUST_PROXY=1
TRUST_PROXY=
# Enable HSTS only if HTTPS is guaranteed at the edge
ENABLE_HSTS=false

# Auth
# REQUIRED in production (no default fallback allowed)
AUTH_JWT_SECRET=change_me_strong_secret
AUTH_JWT_EXPIRES_IN=12h
AUTH_REFRESH_EXPIRES_IN_DAYS=14
AUTH_REFRESH_PEPPER=CHANGE_ME_REFRESH_PEPPER
AUTH_MAX_SESSIONS_PER_USER=10
# Demo seed is OFF by default. Use SEED_PROFILE=demo only for local demo environments.
ALLOW_DEMO_SEED=false
SEED_PROFILE=baseline
# Safety: refuse in-memory fallback. In staging/production the app now ignores any attempt to enable this.
ALLOW_IN_MEMORY_FALLBACK=false


# Uploads
ATHEEL_UPLOAD_DIR=runtime_uploads

# Wave60: Object Store (تخزين ملفات التصدير كبيرة الحجم خارج الرسائل)
# في التطوير: تخزين محلي داخل المشروع
OBJECT_STORE_PROVIDER=local
OBJECT_STORE_DIR=runtime_object_store
# مسار مؤقت لتنزيل ملفات S3/MinIO قبل تحويلها إلى Attachments
OBJECT_STORE_TMP_DIR=runtime_object_tmp
# إذا 1: يحذف ملف الـ Object Store بعد تحويله إلى Attachment
OBJECT_STORE_GC_AFTER_ATTACH=0

# Wave61: MinIO / S3-compatible Object Store (بديل للسواقة المحلية)
# لتفعيل MinIO محليًا:
# 1) شغل infra/docker-compose.dev.yml (سيضيف minio + createbuckets)
# 2) غيّر OBJECT_STORE_PROVIDER إلى s3
# 3) اضبط القيم التالية
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=atheel
# MinIO غالبًا يتطلب path-style (موصى به)
S3_FORCE_PATH_STYLE=1
# اختياري: prefix داخل البكت
S3_KEY_PREFIX=

# Wave60: كيف ترجع exports-svc المخرجات
# object_store: يرجع مؤشرات فقط (موصى به)
# inline: يرجع base64 داخل الرد (للتجارب فقط)
EXPORTS_ARTIFACTS_MODE=object_store

# Worker
# REQUIRED in production
WORKER_TOKEN=change_me
API_BASE_URL=http://localhost:3001

# Cookies (Wave36)
# In production behind HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CSRF + Cookie sessions are enabled automatically when using browser cookies.

# Approvals routing (Wave45/Wave46)
# auto: use skill matrix + workload + fairness/cooldown
# default: governance default approver only
APPROVALS_ROUTING_MODE=auto

# Observability (Wave38)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atheel-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RAG pgvector (Wave39)
RAG_PGVECTOR_ENABLED=true

# Migrations (Wave40)
MIGRATE_ON_START=false

# Secrets via files (Wave40)
# AUTH_JWT_SECRET_FILE=/run/secrets/auth_jwt_secret
# WORKER_TOKEN_FILE=/run/secrets/worker_token
# DATABASE_URL_FILE=/run/secrets/database_url

# Radar
RADAR_CONNECTORS=etimad_api,etimad,moc,rcrc,rcrc_opendata,balady,ungm
RADAR_SCAN_QUEUE=atheel-radar-scan

# Etimad official connector (optional)
ETIMAD_TENDERS_API_URL=
ETIMAD_API_KEY=
ETIMAD_BEARER=

# Obligations reminders
OBLIGATIONS_QUEUE=atheel-obligations

# Wave43: Outbound notification webhooks (optional; used by Outbox)
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# Wave43: Outbox queue name (BullMQ)
OUTBOX_QUEUE=atheel-outbox
OUTBOX_CONCURRENCY=2

# Wave46: Incident + routing tuning (stored per org in OpsSettings, env acts as fallback)
ESCALATION_QUIET_HOURS=23:00-07:00

# Verification (Wave51+)
# Limits are critical to mitigate zip bombs and resource exhaustion
VERIFY_MAX_ZIP_BYTES=125829120
VERIFY_MAX_ZIP_ENTRIES=5000
VERIFY_MAX_UNCOMPRESSED_BYTES=536870912
VERIFY_MAX_ENTRY_UNCOMPRESSED_BYTES=134217728

# Exports Renderer Microservice (Wave57)
EXPORTS_RENDERER_URL=http://localhost:3101
EXPORTS_RENDERER_PORT=3101
EXPORTS_RENDERER_TOKEN=dev_renderer_token_change_me

# Wave59: Channel between API and exports-svc
# http: call /internal/render مباشرة
# rmq: RabbitMQ عبر Nest ClientProxy
# redis: Redis Pub/Sub عبر Nest ClientProxy
EXPORTS_RENDERER_CHANNEL=http

# RabbitMQ (Wave59)
EXPORTS_RMQ_URL=amqp://guest:guest@localhost:5672
EXPORTS_RMQ_QUEUE=atheel.exports.render
EXPORTS_RMQ_PREFETCH=1

# Redis transport (Wave59)
EXPORTS_REDIS_HOST=localhost
EXPORTS_REDIS_PORT=6379

# Render timeout (Wave59)
EXPORTS_RENDER_TIMEOUT_MS=600000

# Service Outbox (Wave58): reliable internal dispatch to microservices (e.g., exports-svc)
SERVICE_OUTBOX_QUEUE=atheel-service-outbox
SERVICE_OUTBOX_CONCURRENCY=2
SERVICE_OUTBOX_MAX_ATTEMPTS=12

# Exports queue (used by Worker to run export orchestration)
EXPORT_QUEUE=atheel-exports
EXPORT_CONCURRENCY=1
